{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QBSI",
  "version": "1.0.0",
  "identifier": "com.tetsuro.customqbsi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QBSI — QuickBooks Sales Invoice",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Custom QBSI Solutions",
    "copyright": "Copyright (c) 2026 Custom QBSI Solutions. All rights reserved.",
    "shortDescription": "QuickBooks Desktop Sales Invoice and Receipt Printing Utility",
    "longDescription": "Desktop printing and layout utility for QuickBooks Desktop Sales Invoices, Collection Receipts, and Delivery Receipts.",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
